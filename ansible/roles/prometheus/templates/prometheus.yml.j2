# {{ ansible_managed }}
global:
  scrape_interval: 30s
  evaluation_interval: 30s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Last convergence per node, read from NetBox by the node API.
  - job_name: cluster-convergence
    static_configs:
      - targets: ["{{ lab_prov_gw }}:{{ lab_node_api_port }}"]

  # node_exporter on every compute node. Targets come from NetBox through the
  # node API, so there is no node list here and N is whatever NetBox says.
  - job_name: node
    http_sd_configs:
      - url: "http://{{ lab_prov_gw }}:{{ lab_node_api_port }}/v1/sd/node-exporter"
        refresh_interval: 60s

  - job_name: slurm
    static_configs:
      - targets: ["localhost:9817"]
