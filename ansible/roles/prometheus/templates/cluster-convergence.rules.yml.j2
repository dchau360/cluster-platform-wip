# {{ ansible_managed }}
groups:
  - name: cluster-convergence
    rules:
      # A node that has not reported a pull run recently. Covers a node that
      # cannot reach the mirror *or* the node API, which cannot report itself.
      - alert: ClusterNodeConvergenceStale
        expr: >-
          time() - cluster_node_last_converged_timestamp_seconds
          > {{ lab_convergence_stale_seconds }}
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.hostname {{ '}}' }} has not converged for {{ '{{' }} $value | humanizeDuration {{ '}}' }}"

      - alert: ClusterNodeConvergenceFailed
        expr: cluster_node_convergence_success == 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.hostname {{ '}}' }}: last pull run failed"
