# {{ ansible_managed }}
# Delivered by the cluster-pull Warewulf runtime overlay. No secret here:
# where to pull from, which ref, and where to report. Read by cluster-pull.
CLUSTER_PULL_URL={{ lab_git_mirror_url }}
CLUSTER_PULL_REF={{ lab_deployed_ref }}
CLUSTER_NODE_API={{ lab_node_api_url }}
CLUSTER_PULL_DIR=/var/lib/cluster-pull/checkout
CLUSTER_PULL_PLAYBOOK=ansible/local.yml
