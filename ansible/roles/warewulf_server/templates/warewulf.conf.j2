---
ipaddr: {{ warewulf_server_ipaddr }}
netmask: {{ warewulf_server_netmask }}
network: {{ warewulf_server_network }}
warewulf:
    port: {{ warewulf_server_http_port }}
    tls port: 9874
    secure: false
    update interval: 60
    autobuild overlays: true
    # The lab's dnsmasq is the only DHCP/TFTP server on the segment, and it
    # is generated by scripts/net-up.sh. Warewulf must not write a second
    # dnsmasq configuration, so the host overlay that would do so is off.
    host overlay: false
    grubboot: false
    systemd name: warewulfd
api:
    enabled: false
    allowed subnets:
        - 127.0.0.0/8
        - ::1/128
dhcp:
    enabled: {{ warewulf_server_manage_dhcp | bool | lower }}
tftp:
    enabled: {{ warewulf_server_manage_tftp | bool | lower }}
    tftproot: {{ warewulf_server_tftproot }}
    systemd name: dnsmasq
    ipxe:
        "00:00": undionly.kpxe
        "00:07": snponly.efi
        "00:09": snponly.efi
nfs:
    enabled: false
ssh:
    key types:
        - ed25519
        - ecdsa
        - rsa
image mounts:
    - source: /etc/resolv.conf
      dest: /etc/resolv.conf
      readonly: true
paths:
    # The distribution iPXE binaries, not a Warewulf fork. `wwctl configure
    # tftp` copies them into the tftpboot tree under the names above.
    ipxesource: {{ warewulf_server_ipxe_source }}
