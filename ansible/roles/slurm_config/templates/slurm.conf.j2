# {{ ansible_managed }}
#
# Rendered by the slurm_config role. Do not edit: every value below is from
# NetBox (nodes, addresses, CPUs, memory, GPUs) or from lab/local.env (site
# names and ports), and the next render replaces this file.
#
# Configless: SlurmctldParameters=enable_configless. Compute nodes run
# `slurmd --conf-server` and fetch this file from slurmctld at start.
ClusterName={{ lab_slurm_cluster_name }}
SlurmctldHost={{ slurm_config_controller_host }}({{ lab_prov_gw }})
SlurmctldPort={{ lab_slurmctld_port }}
SlurmdPort={{ lab_slurmd_port }}
SlurmctldParameters=enable_configless

AuthType=auth/munge
CredType=cred/munge
SlurmUser={{ cluster_slurm_user.name }}
SlurmdUser=root

StateSaveLocation={{ slurm_config_state_dir }}
SlurmdSpoolDir=/var/spool/slurmd
SlurmctldLogFile={{ slurm_config_log_dir }}/slurmctld.log
SlurmdLogFile={{ slurm_config_log_dir }}/slurmd.log

ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
{% if slurm_config_model.switches %}
TopologyPlugin=topology/tree
{% else %}
# No active node is cabled to a switch yet (every node may be in burn-in), and
# topology/tree is fatal with no switches, so no topology plugin until there is.
{% endif %}
{% if slurm_config_model.gres %}
GresTypes=gpu
{% endif %}

# A node that was down comes back on its own once it registers with a valid
# configuration; the day-2 plays drain and resume explicitly.
ReturnToService=2
SlurmdTimeout=120
MinJobAge=300

# The rolling-update drill's "no job loss" evidence: every job's final state.
JobCompType=jobcomp/filetxt
JobCompLoc={{ slurm_config_jobcomp_log }}

# Accounting: slurmctld sends every job and step to slurmdbd on this head
# node, which keeps them in MariaDB (the slurm_accounting role). `sacct`,
# `sreport` and `sacctmgr` read it there. Nodes never contact slurmdbd.
AccountingStorageType=accounting_storage/slurmdbd
AccountingStorageHost={{ slurm_config_accounting_storage_host }}
AccountingStoragePort={{ lab_slurmdbd_port }}
# Per-step CPU, memory and I/O, sampled from the job's cgroup on the node.
JobAcctGatherType=jobacct_gather/cgroup
JobAcctGatherFrequency={{ slurm_config_jobacct_gather_frequency }}

# --- nodes: NetBox, status=active, role=compute -----------------------------
{% for node in slurm_config_model.nodes %}
NodeName={{ node.name }} NodeAddr={{ node.addr }} CPUs={{ node.cpus }} RealMemory={{ node.real_memory }}{% if node.gpus %} Gres=gpu:{{ node.gpus }}{% endif %} State=UNKNOWN
{% endfor %}
{% if slurm_config_model.nodes %}

PartitionName={{ lab_slurm_partition }} Nodes={{ slurm_config_model.nodes | map(attribute='name') | join(',') }} Default=YES MaxTime=INFINITE State=UP
{% endif %}
