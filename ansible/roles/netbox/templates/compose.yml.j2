services:
  netbox:
    image: netboxcommunity/netbox:{{ netbox_image_tag | default('v4.1-3.2.0') }}
    restart: unless-stopped
    env_file: /etc/cluster-lab/netbox.env
    ports: ["127.0.0.1:8000:8080"]
    depends_on: [postgres, redis]
  postgres:
    image: postgres:17-alpine
    restart: unless-stopped
    env_file: /etc/cluster-lab/netbox.env
    volumes: ["netbox-db:/var/lib/postgresql/data"]
  redis:
    image: redis:7-alpine
    restart: unless-stopped
volumes:
  netbox-db: {}
