# Rendered from systemd/lab-dnsmasq.service.in by scripts/systemd-install.sh.
#
# Our own dnsmasq, with our own config, bound to the provisioning bridge
# only. The distribution's dnsmasq.service is masked so the two can never
# both claim the port. The config file is generated by net-up.sh, which is
# why this unit requires lab-net.service rather than merely wanting it.
[Unit]
Description=Cluster lab: dnsmasq (DHCP, DNS, TFTP) on the provisioning segment
Documentation=https://github.com/dchau360/cluster-platform-wip
Requires=lab-net.service
After=lab-net.service
PartOf=lab.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/dnsmasq --test -C @LAB_STATE_DIR@/dnsmasq/lab.conf
ExecStart=/usr/sbin/dnsmasq -k -C @LAB_STATE_DIR@/dnsmasq/lab.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
