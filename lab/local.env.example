# cluster-platform-wip — host-specific configuration, EXAMPLE
#
# Copy to lab/local.env on the lab host and fill in. lab/local.env is
# .gitignored and CI fails if any of its values appears in a tracked file.
#
#   cp lab/local.env.example lab/local.env && $EDITOR lab/local.env
#
# Rules for this file:
#   * Every host-specific variable must be NAMED and DOCUMENTED here.
#   * Values here must be blank, synthetic, or lab-internal. Never real.
#   * Example MAC addresses come from the locally-administered range
#     (second hex digit is 2, 6, A or E) so they can never collide with
#     a real NIC and can never identify real hardware.
#
# The `# host-specific` tag is load-bearing, not decoration. It must match the
# list of names in lab/host-specific.vars, and the gate reports any
# disagreement. For every variable on that list: it may not be assigned a value
# here, and its value from local.env is searched for in every tracked file with
# no exemption of any kind.
#
# The list, not the tag, is what the gate trusts. Typing a value over a
# commented declaration deletes the tag in the same edit, so a gate reading
# only tags would fall silent on exactly that mistake.
#
# Leave a listed variable blank, or comment it out when the code has a sane
# fallback. Do not fill one in here "just as a default" — this file is sourced
# before local.env with `set -a`, so a value here is not a default at all. It
# overrides the code's own fallback, and it is the value everyone who clones
# the repository gets.

# ---------------------------------------------------------------------------
# 1. Lab host identity  —  BLANK HERE. NEVER COMMIT A REAL VALUE.
# ---------------------------------------------------------------------------

# SSH target for the Windows lab host, as user@host. Used only by the
# operator's workstation, never by code that runs on the lab host itself.
LAB_HOST_SSH=          # host-specific

# Name of the WSL2 distribution that runs the lab. Not host-specific: this is
# the stock name of an Ubuntu WSL image and it is read by `wsl -d`, which needs
# a real name rather than a fallback.
LAB_WSL_DISTRO=Ubuntu

# Login name inside WSL that owns the lab state directory.
#
# DELIBERATELY UNASSIGNED. The code reads ${LAB_WSL_USER:-${USER:-$(id -un)}},
# so leaving this unset makes the lab run as whoever invokes it — the lab host,
# a CI runner, anyone's clone. Set it in lab/local.env only when the account
# that must OWN the state directory differs from the account running make.
#
# This shipped `ubuntu` once, on the reasoning that `ubuntu` is the stock login
# in an Ubuntu WSL image and so identifies nothing. The disclosure argument was
# fine; the mechanism was not. This file is sourced with `set -a`, so assigning
# anything here makes the fallback dead code and hard-codes one machine's
# account for every machine. CI caught it on the first push: `chown: invalid
# user: 'ubuntu'` on a runner whose account is `runner`.
#LAB_WSL_USER=          # host-specific

# ---------------------------------------------------------------------------
# 2. Home LAN  —  the network the provisioning segment must NEVER reach.
#    BLANK HERE. Used by `make verify-isolation` to prove unreachability.
# ---------------------------------------------------------------------------

# Home LAN in CIDR form, e.g. the /24 your router hands out.
LAB_LAN_CIDR=          # host-specific

# One address on the home LAN that must be unreachable from the
# provisioning bridge. The isolation test pings this and expects failure.
#
# It must be an address that DOES answer ping over the default route,
# because the isolation test uses that as its positive control: without
# one, "unreachable" could just mean the target is down and every test
# would pass for the wrong reason. The home router is the usual choice.
#
# Do NOT use the lab host's own LAN address. On WSL2 the Hyper-V firewall
# drops ICMP from the WSL network to the Windows host, so it fails the
# positive control while being perfectly reachable in every other sense.
LAB_LAN_PROBE_IP=      # host-specific

# ---------------------------------------------------------------------------
# 3. Provisioning segment  —  created by this repo. Not host-specific.
#    These defaults are safe to commit and safe to leave unchanged.
# ---------------------------------------------------------------------------

# Isolated Linux bridge. No uplink, no route to the home LAN.
PROV_BRIDGE=br-prov

# The segment's subnet. It does NOT have to exist anywhere: `make up` creates
# the bridge, puts the first address on it as the head node's gateway, and
# serves DHCP to the nodes from it. It only has to be unused. `make up` refuses
# a subnet that overlaps a route on another interface, a Docker network or
# LAB_LAN_CIDR, and names what it clashes with.
#
# Leave it unset for the default in netbox/definition.yml (a /22 in 10.44/16).
# Otherwise any private IPv4 /22 or larger, for example 10.46.0.0/22. Prefer
# 10.x: WSL picks its own 172.16-31.x network at boot and could land on yours.
# The gateway, node addresses and the dynamic/discovery pool keep their
# offsets inside it, so node 1 is always <subnet>.20.
#
# Changing it on a lab that is already built moves every node: run
# `make down && make demo N=<n>` afterwards. See README section 4.
#PROV_SUBNET=

# Prefix, gateway, netmask, static offset and the separate dynamic/discovery
# pool are rendered from PROV_SUBNET and netbox/definition.yml by
# scripts/lib/common.sh.
#
# RETIRED. These used to be set here, so every local.env copied from an older
# example still assigns them. They stay declared, with no value, so such a
# local.env still passes the gate. Whatever value it carries is ignored:
# common.sh renders the address plan after sourcing local.env and overwrites
# all of them. The `# retired` tag exempts them from the exact-match check,
# because their old values are the old repo-defined /24 the docs still
# describe. Delete them from your local.env when convenient.
#PROV_CIDR=             # retired
#PROV_PREFIX=           # retired
#PROV_GW=               # retired
#PROV_DHCP_START=       # retired
#PROV_DHCP_END=         # retired
#PROV_DHCP_LEASE=       # retired
#PROV_NODE_IP_OFFSET=   # retired

# DNS domain for provisioned nodes.
PROV_DOMAIN=lab.internal

# Give compute nodes outbound internet access through source NAT on the head
# node. Off by default. This does not expose the nodes to the home LAN, and
# dnsmasq remains bound only to PROV_BRIDGE so DHCP/TFTP never leave the lab.
NODE_INTERNET_ACCESS=no

# Upstream DNS servers for node lookups when NODE_INTERNET_ACCESS=yes, space
# or comma separated. Empty means use the head node's own resolvers.
NODE_DNS_UPSTREAM=

# OUI used when generating synthetic node MACs. Must stay in the
# locally-administered range so it can never collide with real hardware.
PROV_MAC_OUI=52:54:00

# ---------------------------------------------------------------------------
# 4. Node shape  —  nothing in this repo may assume a node count.
#    N=2 and N=4 must both work with no code change.
# ---------------------------------------------------------------------------

# Default node count. Always overridable: `make demo N=4`.
NODE_COUNT=2

# Per-node virtual hardware.
NODE_VCPUS=2
NODE_MEM_MB=2048
NODE_DISK_GB=20
NODE_NAME_PREFIX=cn

# ---------------------------------------------------------------------------
# 5. Paths on the lab host
# ---------------------------------------------------------------------------

# Writable state: TFTP tree, dnsmasq leases, timings, run files.
# Never inside the repo. Never in git.
LAB_STATE_DIR=/var/lib/cluster-lab

# Node disk images and per-VM UEFI nvram. Kept under the libvirt image tree
# because the libvirt AppArmor profile already grants QEMU access there.
LAB_VM_DIR=/var/lib/libvirt/images/cluster-lab

# libvirt connection URI.
LIBVIRT_URI=qemu:///system

# OVMF firmware for UEFI/PXE boot.
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.fd
OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.fd

# ---------------------------------------------------------------------------
# 6. Warewulf provisioning server
# ---------------------------------------------------------------------------
#
# Warewulf is built from source with the default /usr/local prefix, so its
# configuration is /usr/local/etc/warewulf/warewulf.conf and its state lives
# under /var/local. The packaged paths (/etc/warewulf, /var/lib/warewulf)
# are not used, and writing to them would be silently ignored.

# Warewulf state root, and the TFTP tree inside it. scripts/net-up.sh points
# lab-dnsmasq's tftp-root at WAREWULF_TFTP_ROOT, and the Ansible role fills
# it with the iPXE boot programmes.
WAREWULF_STATE_ROOT=/var/local/warewulf
WAREWULF_TFTP_ROOT=/var/local/warewulf/tftpboot

# warewulfd's HTTP port. Serves the iPXE script and the node image over the
# provisioning segment. Not port 80: the git mirror already owns it.
WAREWULF_HTTP_PORT=9873

# The node image. A PUBLIC package, imported by URI with no credential,
# because a credential on the provisioning host is a credential on every
# node that can reach it.
WAREWULF_IMAGE_REGISTRY=ghcr.io/dchau360/cluster-images-wip
WAREWULF_IMAGE_NAME=compute-slurm

# The image tag to import. `latest` follows the newest build; pin a
# `sha-...` tag to roll back, which is one variable change and a reboot.
WAREWULF_IMAGE_TAG=latest

# The discovery image, published by the same registry and workflow as the
# node image: the live boot that scrapes hardware, registers the node in
# NetBox and claims its IPAM allocation. See `make discover` and
# docs/discovery.md.
WAREWULF_DISCOVERY_IMAGE_NAME=discovery

# iPXE provisioning method, as a node tag. The iPXE binary a distribution
# ships has no `imgextract` command, so the two-stage `dracut` method is the
# one that works without a patched iPXE. The node image must ship an
# initramfs with the `wwinit` module, which cluster-images-wip builds in.
WAREWULF_IPXE_METHOD=dracut

# ---------------------------------------------------------------------------
# 7. Redfish management (sushy-emulator)
# ---------------------------------------------------------------------------
#
# sushy-emulator exposes real power control and real boot-order changes for
# the libvirt/KVM nodes over Redfish. It is not a vendor BMC; see
# docs/redfish.md for what it does and does not model.

# TCP port on the provisioning address. The endpoint is therefore
# http://<PROV_GW>:<port>, and scripts/redfish.sh reads both.
SUSHY_EMULATOR_PORT=8000

# NetBox on the provisioning segment.
#
# The control host uses http://127.0.0.1:8000; a node cannot, so the compose
# stack also publishes NetBox on the segment gateway. sushy-emulator already
# owns <PROV_GW>:8000, so NetBox gets its own port. The discovery payload
# reads NETBOX_URL from the overlay the Warewulf role builds.
NETBOX_SEGMENT_PORT=8001

# ---------------------------------------------------------------------------
# 8. Timeouts, seconds
# ---------------------------------------------------------------------------

DHCP_LEASE_TIMEOUT=120
VM_SHUTDOWN_TIMEOUT=30

# How long the boot-phase watcher waits for one node to reach the login
# prompt. Firmware to login measured under 75s on the lab; the margin covers
# a cold image import or a contended disk. The phase that never ended is
# recorded with status=fail, not lost.
BOOT_PHASE_TIMEOUT=300

# ---------------------------------------------------------------------------
# Node self-configuration and Slurm (SRE-7). Lab-internal defaults; none of
# these is host-specific. See docs/node-self-configuration.md.
# ---------------------------------------------------------------------------

# Head-node API a node reads its NetBox record through, on PROV_GW.
NODE_API_PORT=8002
PULL_INTERVAL_SECONDS=900
# The git ref nodes pull. Promotion moves it; nodes never pull `main`.
DEPLOYED_REF=deployed
# Pull timer: repeat interval after the previous run ends, and random splay.
PULL_INTERVAL=15min
PULL_SPLAY=5min
PULL_TIMEOUT=20min
# A node with no report for this long is stale (alert and `make convergence-status`).
CONVERGENCE_STALE_SECONDS=3600
NODE_EXPORTER_PORT=9100

SLURM_CLUSTER_NAME=lab
SLURMCTLD_PORT=6817
SLURMD_PORT=6818
SLURM_PARTITION=compute
# Accounting: slurmdbd's port on the head node, and the account sacctmgr
# puts the job users in.
SLURMDBD_PORT=6819
SLURM_ACCOUNT=lab
# Memory per node kept from Slurm for the OS, subtracted from the NetBox value.
SLURM_MEM_RESERVE_MIB=256

# ---------------------------------------------------------------------------
# 10. Acceptance (SRE-8). `make demo` is not finished at a login prompt; it is
# finished when a node can take work. See docs/acceptance-drills.md.
# ---------------------------------------------------------------------------

# How long `make slurm-ready` waits for a booted node to register with
# slurmctld. It covers the whole chain after the login prompt: cluster-pull
# clones the deployed ref, fetches facts, configures the node, and slurmd
# then fetches its configuration from the controller. Measured at about 70s
# per node on the lab, and a node that boots while slurmctld is still coming
# up retries for about two minutes before it registers.
SLURM_READY_TIMEOUT=600

# How long `make nodes-activate` waits for a staged node to post its own
# burn-in measurements. The node runs stress-ng and fio before it reports, so
# this covers the burn-in itself, not just the HTTP call.
BURNIN_REPORT_TIMEOUT=600

# The acceptance job array: one task per node, each asking for a whole node.
# The payload is deliberately small; what is being proved is that work lands
# on every node, not how fast the node is.
SLURM_ARRAY_PAYLOAD='hostname; sleep 3'
SLURM_ARRAY_TIME_LIMIT=5
SLURM_ARRAY_TIMEOUT=300
# How long the array's records may take to reach `sacct` after the last task
# leaves the queue. slurmctld sends them to slurmdbd asynchronously.
SLURM_SACCT_TIMEOUT=60

# The Soft-RoCE bandwidth test (`make rdma-test`). The node pair is given by
# index, so nothing here knows a node name or a node count.
RDMA_TEST_SERVER_INDEX=1
RDMA_TEST_CLIENT_INDEX=2
# The RDMA device the node's own `rdma_soft_roce` role creates.
RDMA_DEVICE=rxe0
# perftest arguments. 65536-byte messages, 5000 iterations: long enough for
# the average to settle, short enough that the whole test is seconds.
RDMA_TEST_SIZE=65536
RDMA_TEST_ITERS=5000
RDMA_TEST_TIMEOUT=180
# The benchmarks to run, in order. RDMA WRITE is the one-sided verb and SEND
# the two-sided one; both are real traffic over the same verbs path.
RDMA_TEST_TOOLS='ib_write_bw ib_send_bw'
# Extra perftest arguments for both ends, e.g. `-x 1` to pick the RoCEv2
# IPv4 GID instead of GID index 0. Empty unless the lab needs it.
# `-R` is required, not an extra. Soft-RoCE has no subnet manager, so
# perftest's default InfiniBand CM cannot resolve a path; the RDMA CM
# (`-R`) establishes the connection over TCP instead and then runs the
# genuine verbs data path. Without it the client exits on ADDR_ERROR.
RDMA_TEST_EXTRA_ARGS=-R

# How long the cold-start drill waits for systemd and the lab units to come
# back by themselves after the distribution restarts.
COLD_START_TIMEOUT=180

# Node counts `make acceptance` walks, lowest first, to produce the 1-to-N
# curve. A list, not a number: the curve is the deliverable, and which points
# are on it is a property of the lab, not of the code.
ACCEPTANCE_NODE_COUNTS='1 2 4'
