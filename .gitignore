# ---------------------------------------------------------------------------
# Host-specific configuration. Never tracked.
# ---------------------------------------------------------------------------
lab/local.env
lab/local.env.*
!lab/local.env.example

# ---------------------------------------------------------------------------
# Lab state. Disk images, firmware vars, boot trees, dumps. Never tracked.
# ---------------------------------------------------------------------------
*.qcow2
*.qcow2.*
*.qed
*.vmdk
*.vdi
*.raw
*.img
*.iso
*.fd
*.vars
*.nvram

# TFTP / PXE boot trees
tftpboot/
tftproot/
/srv/
pxelinux.cfg/
grub/grub.cfg
*.efi
*.kernel
*.initramfs
*.squashfs
*.cpio
*.cpio.gz

# NetBox dumps and any database export
netbox-dump*
*.netbox.json
*.pgdump
*.sql
*.sql.gz
*.dump

# Ansible
*.retry
.ansible/
ansible/*.log
ansible/inventory/hosts.generated*
fact_cache/

# Runtime state, logs, timing output
state/
run/
var/
logs/
*.log
*.pid
*.lease
*.leases
timings/
*.ndjson

# Secrets of any kind. Belt and braces: these come from Warewulf
# per-node overlays at boot, never from this repo.
*.key
*.pem
*.crt
*.p12
*.jks
id_rsa*
id_ed25519*
ssh_host_*
munge.key
*.vault
.vault-pass*

# Editors, OS, Python
.vscode/
.idea/
*.swp
*~
.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# ---------------------------------------------------------------------------
# Must be tracked. Keep this LAST.
# ---------------------------------------------------------------------------
#
# lab/host-specific.vars holds variable NAMES only, never values, and it is
# the list the hygiene gate trusts to decide what counts as a host value.
#
# This negation lives at the end of the file on purpose. .gitignore is
# last-match-wins, so a negation placed above a broad glob loses to it — the
# `*.vars` rule in the lab-state section swallowed this file when the negation
# sat at the top, and the gate's "manifest is present but untracked" check is
# what caught it. At the end, no later rule can override it.
!lab/host-specific.vars
